+// A portal, proxy error or redirect is never a successful generate_204 probe.
+func validProbeResponse(address string, status int, body []byte) bool {
+	if status < 200 || status >= 300 || len(body) > 65536 {
+		return false
+	}
+	u, err := url.Parse(address)
+	if err != nil {
+		return false
+	}
+	if strings.HasSuffix(strings.TrimRight(strings.ToLower(u.Path), "/"), "generate_204") {
+		return status == 204 && len(body) == 0
+	}
+	if strings.EqualFold(u.Hostname(), "www.msftconnecttest.com") && u.Path == "/connecttest.txt" {
+		return status == 200 && strings.TrimSpace(string(body)) == "Microsoft Connect Test"
+	}
+	if strings.EqualFold(u.Hostname(), "www.apple.com") && u.Path == "/library/test/success.html" {
+		return status == 200 && strings.Contains(strings.ToLower(string(body)), "<title>success</title>")
+	}
+	if strings.EqualFold(u.Hostname(), "detectportal.firefox.com") && u.Path == "/success.txt" {
+		return status == 200 && strings.TrimSpace(string(body)) == "success"
+	}
+	return true
+}
+
+// One failed diagnostic provider cannot mark a working route dead. Keep custom
+// probes exact; use independently hosted known responses for built-in 204 URLs.
+func probeTargets(address string) []string {
+	switch address {
+	case "", "https://www.google.com/generate_204", "https://www.gstatic.com/generate_204", "https://www.youtube.com/generate_204", "https://www.googlevideo.com/generate_204", "http://www.google.com/generate_204", "http://www.gstatic.com/generate_204", "http://www.youtube.com/generate_204", "http://www.googlevideo.com/generate_204":
+		return []string{address, "https://cp.cloudflare.com/generate_204", "https://detectportal.firefox.com/success.txt"}
+	default:
+		return []string{address}
+	}
+}
+
+func measureInstDelay(ctx context.Context, inst *core.Instance, outboundTag string, address string) (int64, error) {
+	targets := probeTargets(address)
+	if len(targets) == 1 {
+		return measureInstDelayOnce(ctx, inst, outboundTag, address)
+	}
+	return measureProbeTargets(ctx, targets, func(attempt context.Context, target string) (int64, error) {
+		return measureInstDelayOnce(attempt, inst, outboundTag, target)
+	})
+}
+
+// Keep one transaction in flight per profile. Parallel provider fan-out multiplied
+// every batch into dozens of TLS handshakes and exhausted mobile network budgets.
+func measureProbeTargets(ctx context.Context, targets []string, measure func(context.Context, string) (int64, error)) (int64, error) {
+	ctx, cancel := context.WithTimeout(ctx, 12*time.Second)
+	defer cancel()
+	var lastErr error
+	for i, target := range targets {
+		if ctx.Err() != nil {
+			return -1, ctx.Err()
+		}
+		deadline, _ := ctx.Deadline()
+		budget := time.Until(deadline) / time.Duration(len(targets)-i)
+		attempt, finish := context.WithTimeout(ctx, budget)
+		delay, err := measure(attempt, target)
+		finish()
+		if err == nil && delay > 0 {
+			return delay, nil
+		}
+		lastErr = err
+	}
+	return -1, lastErr
+}
