<resources>
    <color name="window_background_light">#FFF5F6F8</color>
    <color name="window_background_dark">#FF0B0F14</color>

    <style name="AppThemeBase" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/window_background_light</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="AppThemeDayNight" parent="AppThemeBase" />

    <style name="AppThemeDayNight.NoActionBar" parent="AppThemeBase" />

    <style name="AppThemeDayNight.NoActionBar.Translucent" parent="AppThemeBase">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
