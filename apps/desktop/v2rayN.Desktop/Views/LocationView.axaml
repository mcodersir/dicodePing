<UserControl
    x:Class="v2rayN.Desktop.Views.LocationView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:DataType="vms:ProfilesViewModel"
    Background="{DynamicResource DicodePageBackground}">
    <Border Margin="8" Padding="14" Classes="DicodeCard">
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Margin="0,0,0,12"
                FontWeight="SemiBold"
                Text="{x:Static resx:ResUI.DicodeLocationPanelTitle}"
                TextWrapping="Wrap" />
            <DataGrid
                AutoGenerateColumns="False"
                CanUserResizeColumns="True"
                IsReadOnly="True"
                ItemsSource="{Binding ProfileItems}">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="2*" Binding="{Binding Remarks}" Header="{x:Static resx:ResUI.LvRemarks}" />
                    <DataGridTextColumn Width="2*" Binding="{Binding Address}" Header="{x:Static resx:ResUI.LvAddress}" />
                    <DataGridTextColumn Width="2*" Binding="{Binding IpInfo}" Header="{x:Static resx:ResUI.LvTestIpInfo}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
