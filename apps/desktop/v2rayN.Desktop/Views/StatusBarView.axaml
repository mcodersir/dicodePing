<UserControl
    x:Class="v2rayN.Desktop.Views.StatusBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:DataType="vms:StatusBarViewModel">
  <Border Margin="8" Padding="12" CornerRadius="14" BorderThickness="1">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="btnToggleConnection" MinWidth="116" Classes.Success="{Binding IsConnected}">
          <TextBlock Text="{Binding ConnectionStatusText}" />
        </Button>
        <Button x:Name="btnSmartConnection" ToolTip.Tip="اتصال هوشمند" Content="⚡ بهترین" />
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="txtRunningServerDisplay" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="txtRunningInfoDisplay" Opacity="0.72" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock x:Name="txtInboundDisplay" HorizontalAlignment="Right" />
        <TextBlock x:Name="txtInboundLanDisplay" HorizontalAlignment="Right" Opacity="0.72" />
        <TextBlock x:Name="txtTotalTrafficDisplay" HorizontalAlignment="Right" />
      </StackPanel>
      <TextBlock x:Name="txtSpeedProxyDisplay" IsVisible="False" />
      <TextBlock x:Name="txtSpeedDirectDisplay" IsVisible="False" />
      <ToggleSwitch x:Name="togEnableTun" IsVisible="False" />
      <ComboBox x:Name="cmbSystemProxy" IsVisible="False"><ComboBoxItem /></ComboBox>
      <ComboBox x:Name="cmbRoutings2" IsVisible="False" ItemsSource="{Binding RoutingItems}" />
    </Grid>
  </Border>
</UserControl>
